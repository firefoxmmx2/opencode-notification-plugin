  "description": "OpenCode TUI 任务完成通知插件 - 在任务完成后发送系统通知",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "bun build src/index.ts --outdir dist --target node --watch"
  },
  "keywords": [
    "opencode",
    "notification",
    "plugin",
    "tui"
  ],
  "author": "firefoxmmx2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/firefoxmmx2/opencode-notification-plugin.git"
  },
  "devDependencies": {
    "bun": "^1.3.11"
  }
}
